---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import Device from './Device.astro';
import ProductCard from './ProductCard.astro';
import { shopCopy, products, productPath } from '../data/shop';
import type { Locale } from '../data/i18n';
const { locale = 'en' } = Astro.props as { locale: Locale };
const t = shopCopy[locale];
---
<Layout locale={locale}>
  <section class="shop-hero container"><div class="shop-hero-copy"><div class="eyebrow"><span class="tiny-dot"></span>{t.eyebrow}</div><h1>{t.heroFirst}<br/><em>{t.heroSecond}</em></h1><p>{t.heroText}</p><div class="shop-hero-actions"><a class="button button-dark" href="#catalog">{t.heroCta}<Icon name="arrow"/></a><a class="hero-secondary" href="#ai-concept">{t.heroSecondary}<Icon name="diagonal" size={14}/></a></div><span class="shop-hero-note"><span class="tiny-dot"></span>{t.heroNote}</span><div class="hero-model-label"><span>01 / SCIENTIFIC</span><strong>CASIO fx-300ES PLUS</strong></div></div><div class="hero-device"><div class="hero-glow"></div><div class="device-orbit orbit-a"></div><div class="device-orbit orbit-b"></div><span class="hero-coordinate coordinate-top">PRECISION / EVERY DAY</span><span class="hero-coordinate coordinate-side">√144 + 2³ = 20</span><Device id="hero-device"/><div class="hero-device-feature"><span class="feature-dot"></span><div><small>{locale==='en'?'READ IT NATURALLY':'ПОНЯТНОЕ ОТОБРАЖЕНИЕ'}</small><strong>Natural Textbook Display</strong></div></div><a class="hero-product-link" href={productPath(locale,'casio-fx-300es-plus')}><div><small>{t.featured}</small><span>fx-300ES PLUS</span></div><span class="round-arrow"><Icon name="diagonal" size={21}/></span></a><small class="hero-image-note">{t.illustration}</small></div></section>
  <div class="shop-values"><div class="container">{[[t.stripOne,'cube'],[t.stripTwo,'check'],[t.stripThree,'spark']].map(([text,icon])=><span><Icon name={icon} size={19}/>{text}</span>)}</div></div>
  <section class="shop-catalog container" id="catalog"><div class="shop-section-heading"><div><div class="eyebrow">{t.collection}</div><h2>{t.collectionTitle}</h2></div><p class="preserve-lines">{t.collectionText}</p></div><div class="shop-catalog-controls"><div class="shop-filters" role="group" aria-label={t.catalog}>{[['all',t.all],['scientific',t.scientific],['classroom',t.classroom],['ai',t.ai]].map(([value,label],index)=><button data-shop-filter={value} class:list={{active:index===0}} aria-pressed={index===0?'true':'false'}>{label}{index===0&&<span>04</span>}</button>)}</div><span class="shop-count" data-shop-count>4 {t.count}</span></div><div class="product-grid">{products.map((product,index)=><ProductCard product={product} locale={locale} index={index}/>)}</div><p class="catalog-demo-note">{t.demo} · {t.illustration}</p></section>
  <section class="shop-approach container" id="approach"><div class="approach-art"><span class="art-micro">FOCUS ON WHAT MATTERS.</span><div class="math-art"><span>curiosity</span><span class="equation-plus">+</span><span>precision</span><div class="math-art-line"></div><em>possibility.</em></div><span class="art-asterisk">✱</span><span class="art-bottom">THINK / CREATE / REPEAT</span></div><div class="shop-approach-copy"><div class="eyebrow">{t.approachEyebrow}</div><h2 class="preserve-lines">{t.approachTitle}</h2><p>{t.approachText}</p><p>{t.approachNote}</p><a class="text-link" href="#catalog">{t.approachCta}<Icon name="arrow" size={19}/></a></div></section>
  <section class="ai-hardware container" id="ai-concept"><div class="ai-hardware-copy"><div class="eyebrow"><Icon name="spark" size={15}/>{t.conceptEyebrow}</div><h2 class="preserve-lines">{t.conceptTitle}</h2><p>{t.conceptText}</p><a class="button button-outline" href={productPath(locale,'calcora-ai-one')}>{t.conceptCta}<Icon name="diagonal" size={17}/></a><p class="concept-disclaimer">{t.conceptNote}</p><button class="text-link" data-open-tool="scientific">{t.online}<Icon name="spark" size={16}/></button></div><div class="ai-hardware-art"><span class="ai-art-label">CALCORA / AI ONE</span><Device id="concept-device" brand="CALCORA" model="AI One" concept={true}/><span class="ai-concept-pill">{t.concept}</span></div></section>
  <section class="shop-faq container" id="faq"><div><div class="eyebrow">GOOD TO KNOW</div><h2>{t.faqTitle}</h2><p>{t.faqIntro}</p></div><div class="faq-list">{t.faq.map(([question,answer])=><details><summary>{question}<Icon name="plus"/></summary><p>{answer}</p></details>)}</div></section>
  <section class="shop-closing container"><span aria-hidden="true">✱</span><h2 class="preserve-lines">{t.closing}</h2><a class="button button-dark" href="#catalog">{t.closingCta}<Icon name="arrow"/></a></section>
</Layout>
