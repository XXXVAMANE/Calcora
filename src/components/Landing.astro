---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import ToolCard from './ToolCard.astro';
import { copy, tools, type Locale } from '../data/i18n';
const { locale = 'en' } = Astro.props as { locale: Locale };
const t = copy[locale];
const faqs = [[t.faqOneQ,t.faqOneA],[t.faqTwoQ,t.faqTwoA],[t.faqThreeQ,t.faqThreeA],[t.faqFourQ,t.faqFourA],[t.faqFiveQ,t.faqFiveA]];
---
<Layout locale={locale}>
  <section class="hero container"><div class="hero-copy"><div class="eyebrow"><span class="tiny-dot"></span>{t.eyebrow}</div><h1>{t.heroFirst}<br/><em>{t.heroSecond}</em></h1><p>{t.heroDescription}</p><div class="hero-cta"><a class="button button-dark" href="#catalog">{t.heroAction}<Icon name="arrow"/></a><a class="hero-secondary" href="#how">{t.heroSecondary}<Icon name="diagonal" size={12}/></a></div><span class="hero-cta-note">{t.heroNote}</span><div class="hero-bottom"><span class="mini-spark" aria-hidden="true">✳</span><span>{t.heroBottom}<br/><strong>{t.heroBottomBold}</strong></span><span class="hero-divider"></span><span class="hero-bottom-label preserve-lines">{t.heroBottomLabel}</span></div></div>
    <div class="hero-scene"><div class="scene-orbit orbit-one"></div><div class="scene-orbit orbit-two"></div><span class="scene-plus" aria-hidden="true">+</span><span class="scene-equals" aria-hidden="true">=</span><div class="scene-heading"><span>{t.previewLabel}</span><span>№ 001</span></div><div class="demo-window"><div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>calcora / finance</span><Icon name="diagonal" size={13}/></div><div class="window-content"><span class="demo-tool-label"><Icon name="spark" size={14}/>{t.previewTag}</span><h2>{t.previewQuestion}</h2><div class="demo-input">{t.previewInput}<span aria-hidden="true">↵</span></div><div class="demo-result"><span>{t.previewResultLabel}</span><strong>{t.previewResult}</strong><svg viewBox="0 0 300 70" fill="none" aria-hidden="true"><path d="M0 67 20 62 40 60 60 56 80 54 100 48 120 43 140 39 160 31 180 26 200 20 220 17 240 10 260 7 280 3 300 0V70H0Z" fill="url(#chart-fill)"/><path d="M0 67 20 62 40 60 60 56 80 54 100 48 120 43 140 39 160 31 180 26 200 20 220 17 240 10 260 7 280 3 300 0" stroke="#7360d1" stroke-width="2.5"/><defs><linearGradient id="chart-fill" x1="150" x2="150" y1="0" y2="70" gradientUnits="userSpaceOnUse"><stop stop-color="#c5b6f5" stop-opacity=".6"/><stop offset="1" stop-color="#c5b6f5" stop-opacity="0"/></linearGradient></defs></svg></div><div class="demo-explanation"><span class="explanation-star" aria-hidden="true">✳</span><p>{t.previewExplanation}</p></div><span class="demo-footnote">{t.previewFootnote}</span></div></div><div class="floating-note"><span class="note-dot"></span>{t.previewBadge}</div><button class="scene-product" data-open-tool="finance"><span>{t.previewLink}</span><span class="round-arrow"><Icon name="diagonal" size={21}/></span></button></div>
  </section>
  <div class="values-strip"><div class="container"><span><Icon name="spark" size={18}/>{t.stripOne}</span><span class="strip-star" aria-hidden="true">✳</span><span><Icon name="cube" size={18}/>{t.stripTwo}</span><span class="strip-star" aria-hidden="true">✳</span><span><Icon name="heart" size={18}/>{t.stripThree}</span></div></div>
  <section class="catalog section container" id="catalog"><div class="section-heading"><div><div class="eyebrow">{t.catalogEyebrow}</div><h2>{t.catalogTitle}<br/><span class="muted-heading">{t.catalogTitleMuted}</span></h2></div><p class="preserve-lines">{t.catalogDescription}</p></div><div class="catalog-controls"><div class="filter-tabs" role="group" aria-label={t.calculators}><button class="active" data-filter="all" aria-pressed="true">{t.filterAll}<span>4</span></button><button data-filter="math" aria-pressed="false">{t.filterMath}</button><button data-filter="finance" aria-pressed="false">{t.filterFinance}</button><button data-filter="everyday" aria-pressed="false">{t.filterEveryday}</button></div><span class="catalog-count" id="catalog-count" aria-live="polite">4 {t.toolCount}</span></div><div class="tool-grid">{tools.map((tool,index) => <ToolCard tool={tool} locale={locale} index={index}/>)}</div></section>
  <section class="philosophy container" id="philosophy"><div class="philosophy-art"><span class="art-label">{t.philosophyArtLabel}</span><div class="art-circle"></div><div class="equation-paper"><span class="paper-caption">{locale==='en'?'THE LITTLE THINGS ADD UP':'ИЗ МАЛОГО СКЛАДЫВАЕТСЯ БОЛЬШОЕ'}</span><span class="paper-equation">{locale==='en'?'curiosity':'интерес'}<br/><i>+</i> {locale==='en'?'clarity':'ясность'}<br/><span class="paper-line"></span><em>{locale==='en'?'possibility.':'новые идеи.'}</em></span><span class="paper-spark" aria-hidden="true">✳</span></div><span class="art-doodle" aria-hidden="true">✳</span><div class="art-caption preserve-lines">{t.philosophyArtCaption}</div><span class="art-notation" aria-hidden="true">{locale==='en'?'01 — THINK / UNDERSTAND':'01 — ДУМАТЬ / ПОНИМАТЬ'}</span></div><div class="philosophy-copy"><div class="eyebrow">{t.philosophyEyebrow}</div><h2>{t.philosophyTitle}<br/><em>{t.philosophyEm}</em></h2><p>{t.philosophyText}</p><p>{t.philosophyTextTwo}</p><a class="text-link" href="#catalog">{t.philosophyLink}<Icon name="arrow"/></a></div></section>
  <section class="how section container" id="how"><div class="center-heading"><div class="eyebrow">{t.howEyebrow}</div><h2>{t.howTitle}</h2><p>{t.howDescription}</p></div><div class="how-grid">{[[t.stepOneTitle,t.stepOneText,'search'],[t.stepTwoTitle,t.stepTwoText,'plus'],[t.stepThreeTitle,t.stepThreeText,'spark']].map(([title,text,icon],index) => <article class="how-card"><div class="how-card-top"><span>0{index + 1}</span><Icon name={icon} size={28}/></div><h3>{title}</h3><p>{text}</p></article>)}</div></section>
  <section class="pricing section" id="pricing"><div class="container"><div class="center-heading"><div class="eyebrow">{t.pricingEyebrow}</div><h2>{t.pricingTitle}</h2><p>{t.pricingDescription}</p></div><div class="billing-wrap"><div class="billing-toggle" role="group" aria-label={t.pricing}><button class="active" data-billing="monthly" aria-pressed="true">{t.monthly}</button><button data-billing="yearly" aria-pressed="false">{t.yearly}</button></div><span>{t.save}</span></div><div class="pricing-grid"><article class="price-card"><span class="plan-icon"><Icon name="leaf" size={24}/></span><h3>{t.starterName}</h3><p>{t.starterTag}</p><div class="plan-price"><strong>$0</strong><span>{t.perMonth}</span></div><span class="billing-note">{t.free}</span><a class="button button-outline full-width" href="#catalog">{t.starterCta}<Icon name="arrow" size={18}/></a><ul>{[t.starterFeatureOne,t.starterFeatureTwo,t.starterFeatureThree].map(feature=><li><Icon name="check" size={17}/>{feature}</li>)}</ul></article><article class="price-card featured"><span class="popular-label">{t.popular}<Icon name="spark" size={14}/></span><span class="plan-icon"><Icon name="spark" size={24}/></span><h3>{t.proName}</h3><p>{t.proTag}</p><div class="plan-price"><strong data-price-monthly="12" data-price-yearly="9.60">$12</strong><span>{t.perMonth}</span></div><span class="billing-note" data-billing-note>{t.billedMonthly}</span><button class="button button-purple full-width" data-plan="Pro">{t.proCta}<Icon name="arrow" size={18}/></button><ul>{[t.proFeatureOne,t.proFeatureTwo,t.proFeatureThree,t.proFeatureFour].map(feature=><li><Icon name="check" size={17}/>{feature}</li>)}</ul></article><article class="price-card"><span class="plan-icon"><Icon name="cube" size={24}/></span><h3>{t.studioName}</h3><p>{t.studioTag}</p><div class="plan-price"><strong data-price-monthly="29" data-price-yearly="23.20">$29</strong><span>{t.perMonth}</span></div><span class="billing-note" data-billing-note>{t.billedMonthly}</span><button class="button button-outline full-width" data-plan="Studio">{t.studioCta}<Icon name="arrow" size={18}/></button><ul>{[t.studioFeatureOne,t.studioFeatureTwo,t.studioFeatureThree,t.studioFeatureFour].map(feature=><li><Icon name="check" size={17}/>{feature}</li>)}</ul></article></div><p class="pricing-note">{t.pricingNote}</p></div></section>
  <section class="faq section container" id="faq"><div><div class="eyebrow">{t.faqEyebrow}</div><h2>{t.faqTitle}<br/><em>{t.faqEm}</em></h2><p>{t.faqDescription}</p></div><div class="faq-list">{faqs.map(([question,answer]) => <details><summary>{question}<Icon name="plus"/></summary><p>{answer}</p></details>)}</div></section>
  <section class="closing-banner container"><span class="closing-spark" aria-hidden="true">✳</span><div><div class="eyebrow">{t.closingEyebrow}</div><h2>{t.closingFirst}<br/><em>{t.closingEm}</em></h2></div><a class="button button-dark" href="#catalog">{t.closingCta}<Icon name="arrow"/></a></section>
</Layout>
