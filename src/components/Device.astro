---
const { model = 'fx-300ES PLUS', brand = 'CASIO', tone = 'lilac', id = 'device', concept = false } = Astro.props;
const scientific = ['SHIFT','ALPHA','▲','MODE','ON','x⁻¹','nCr','Pol(','x³','a b/c','√','x²','^','log','ln','(-)','°′″','hyp','sin','cos','tan','RCL','(',')','S⇔D'];
const scientificKeys = scientific.map((label,index) => ({label,index,row:Math.floor(index/5),col:index%5}));
const numeric = ['7','8','9','DEL','AC','4','5','6','×','÷','1','2','3','+','−','0','.','×10ˣ','Ans','='];
const numericKeys = numeric.map((label,index) => ({label,index,row:Math.floor(index/5),col:index%5}));
---
<svg class:list={['device-svg', tone]} viewBox="0 0 280 530" fill="none" role="img" aria-label={`${brand} ${model} — ${concept ? 'concept illustration' : 'product illustration'}`}>
  <defs><linearGradient id={`${id}-shell`} x1="25" y1="5" x2="255" y2="525" gradientUnits="userSpaceOnUse"><stop stop-color="#50515c"/><stop offset=".45" stop-color="#24262f"/><stop offset="1" stop-color="#11131a"/></linearGradient><linearGradient id={`${id}-edge`} x1="0" y1="0" x2="280" y2="530"><stop stop-color="#8c8b99"/><stop offset=".5" stop-color="#292b35"/><stop offset="1" stop-color="#50505e"/></linearGradient><linearGradient id={`${id}-key`} x1="0" y1="0" x2="0" y2="30"><stop stop-color="#555761"/><stop offset="1" stop-color="#30323c"/></linearGradient></defs>
  <rect x="9" y="5" width="262" height="520" rx="30" fill={`url(#${id}-edge)`}/><rect x="13" y="8" width="254" height="513" rx="28" fill={`url(#${id}-shell)`} stroke="#9998aa" stroke-opacity=".3"/>
  <path d="M32 20H249" stroke="#b9bac6" stroke-opacity=".25"/>
  <text x="31" y="41" fill="#e5e5ed" font-family="Arial,sans-serif" font-size={brand.length > 10 ? 9 : 16} font-weight="700" letter-spacing="1">{brand}</text><text x="31" y="60" fill="#b9b9c5" font-family="Arial,sans-serif" font-size="9">{model}</text>
  <rect x="173" y="31" width="74" height="26" rx="3" fill="#252020" stroke="#625454"/>{[0,1,2,3].map(n=><path d={`M${187+n*15} 33v22`} stroke="#665453" stroke-width="1"/>)}
  <rect x="25" y="76" width="230" height="110" rx="9" fill="#101218" stroke="#767883" stroke-opacity=".7"/><rect x="32" y="83" width="216" height="94" rx="5" fill={concept ? '#202233' : '#c8d0b4'}/>
  {concept ? <><text x="45" y="106" fill="#a89bed" font-family="Arial" font-size="8" letter-spacing="1">CALCORA AI / CONCEPT</text><text x="45" y="130" fill="#f2eeff" font-family="Arial" font-size="14">Let’s work it out.</text><path d="M45 149h127M45 158h92" stroke="#696080" stroke-width="3" stroke-linecap="round"/><path d="m220 107 3 7 7 3-7 3-3 7-3-7-7-3 7-3Z" fill="#ac99f7"/></> : <><text x="42" y="98" fill="#414937" font-family="monospace" font-size="7">M  Math                        D</text><text x="42" y="125" fill="#2f3625" font-family="monospace" font-size="18">√(144) + 2³</text><text x="230" y="163" text-anchor="end" fill="#2f3625" font-family="monospace" font-size="29">20</text></>}
  <text x="140" y="203" text-anchor="middle" fill="#9c9aa8" font-family="Arial" font-size="7" letter-spacing="2">{concept ? 'THINK A LITTLE FURTHER' : 'NATURAL EXPRESSION'}</text>
  {scientificKeys.map(({label,index,row,col}) => (<g><text x={46+col*47} y={222+row*31} text-anchor="middle" fill={index%4===0?'#b9acd7':'#a6a6b1'} font-family="Arial" font-size="5.5">{index%3===0?'OPTN':index%3===1?'CONST':'SETUP'}</text><rect x={27+col*47} y={226+row*31} width="37" height="21" rx="6" fill={`url(#${id}-key)`} stroke="#777785" stroke-opacity=".4"/><text x={45.5+col*47} y={240+row*31} text-anchor="middle" fill="#f2eff8" font-family="Arial" font-size="8">{label}</text></g>))}
  {numericKeys.map(({label,index,row,col}) => (<g><rect x={25+col*47} y={388+row*30} width="40" height="25" rx="6" fill={['DEL','AC'].includes(label)?'#8e79c0':index%5===4?'#525260':'#d2d2da'} stroke="#f2edff" stroke-opacity=".2"/><text x={45+col*47} y={405+row*30} text-anchor="middle" fill={['DEL','AC'].includes(label)||index%5===4?'#fff':'#252631'} font-family="Arial" font-size={label.length>2?8:12} font-weight="600">{label}</text></g>))}
</svg>
