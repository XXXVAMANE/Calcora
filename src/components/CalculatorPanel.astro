---
import Icon from './Icon.astro';
import { copy, tools, type Locale } from '../data/i18n';
const { locale = 'en' } = Astro.props as { locale: Locale };
const t = copy[locale];
---
<div class="calculator-tabs" role="group" aria-label={t.calculators}>{tools.map(tool => <button data-tool-tab={tool.slug} aria-pressed={tool.slug === 'scientific' ? 'true' : 'false'} class:list={{ active: tool.slug === 'scientific' }}>{tool[locale].name}</button>)}</div>
{tools.map(tool => <section data-calculator={tool.slug} hidden={tool.slug !== 'scientific'}>
  <form class="calculator-form" data-calculator-form={tool.slug}>
    {tool.slug === 'scientific' && <><label for="expression">{t.expression}<span>RAD</span></label><input id="expression" name="expression" type="text" value="sqrt(144) + 2^3" placeholder={t.expressionPlaceholder} maxlength="300" required autocomplete="off" spellcheck="false" /><div class="quick-expressions"><button type="button" data-expression="sqrt(144) + 2^3">√(144) + 2³</button><button type="button" data-expression="(120 + 80) * 1.2">(120 + 80) × 1.2</button><button type="button" data-expression="sin(pi / 2)">sin(π / 2)</button></div><div class="keypad">{['(', ')', '^', 'AC', '7', '8', '9', '÷', '4', '5', '6', '×', '1', '2', '3', '−', '.', '0', '%', '+'].map(key => <button type="button" data-key={key}>{key}</button>)}</div></>}
    {tool.slug === 'finance' && <div class="input-grid"><div><label for="finance-principal">{t.principal}</label><input id="finance-principal" name="principal" type="number" value="0" min="0" max="1000000000" step="any" required /></div><div><label for="finance-monthly">{t.monthlyAmount}</label><input id="finance-monthly" name="monthly" type="number" value="250" min="0" max="10000000" step="any" required /></div><div><label for="finance-rate">{t.rate}</label><input id="finance-rate" name="rate" type="number" value="5" min="0" max="100" step="any" required /></div><div><label for="finance-years">{t.years}</label><input id="finance-years" name="years" type="number" value="10" min="0" max="100" step="1" required /></div></div>}
    {tool.slug === 'percentage' && <div class="input-grid"><div><label for="percentage-percent">{t.percent}</label><input id="percentage-percent" name="percent" type="number" value="25" step="any" required /></div><div><label for="percentage-amount">{t.amount}</label><input id="percentage-amount" name="amount" type="number" value="480" step="any" required /></div></div>}
    {tool.slug === 'converter' && <><label for="unit-type">{t.unitType}</label><select id="unit-type" name="unitType"><option value="length">{t.length}</option><option value="weight">{t.weight}</option><option value="temperature">{t.temperature}</option></select><div class="input-grid unit-grid"><div><label for="unit-from">{t.from}</label><select id="unit-from" name="from"><option value="mi">mi</option><option value="km">km</option><option value="m">m</option><option value="cm">cm</option><option value="ft">ft</option><option value="in">in</option></select></div><div><label for="unit-to">{t.to}</label><select id="unit-to" name="to"><option value="km">km</option><option value="mi">mi</option><option value="m">m</option><option value="cm">cm</option><option value="ft">ft</option><option value="in">in</option></select></div></div><label for="unit-value">{t.value}</label><input id="unit-value" name="value" type="number" value="10" step="any" required /></>}
    <button class="button button-dark full-width" type="submit">{t.calculate}<Icon name="arrow"/></button>
    <p class="calculator-error" data-calc-error role="alert" hidden></p>
  </form>
  <div class="result-box" data-result-box aria-live="polite"><div class="result-label"><span>{t.result}</span><Icon name="spark" size={18}/></div><output data-result>{tool.answer}</output><span class="result-formula" data-formula>{tool.preview}</span></div>
  <p class="calc-footnote">{tool.slug === 'finance' ? t.financialNote : t.localCalculation}</p>
  <button class="button button-ai full-width" data-explain={tool.slug}><Icon name="spark" size={18}/>{t.explain}</button><p class="ai-hint">{t.aiHint}</p><p class="ai-response" data-ai-response role="status" hidden></p>
</section>)}
