---
import Icon from './Icon.astro';
import { copy, home, type Locale } from '../data/i18n';
const { tool, locale, index } = Astro.props;
const lang = locale as Locale;
const text = tool[lang];
const t = copy[lang];
---
<article class="tool-card" data-tool-card data-category={tool.category}>
  <a href={`${home(lang)}calculators/${tool.slug}/`} class:list={['tool-art', tool.color]} aria-label={text.name}><span class="tool-tag">{text.tag}</span><span class="tool-symbol" aria-hidden="true">{tool.symbol}</span><div class="tool-mini"><span class="mini-label">{tool.slug === 'finance' ? (lang === 'en' ? 'ESTIMATED BALANCE' : 'ОЦЕНКА БАЛАНСА') : 'NUMVORI'}</span><span class="mini-expression">{tool.slug === 'percentage' && lang === 'ru' ? '25% от 480' : tool.preview}</span><span class="mini-answer">{tool.answer}<Icon name="check" size={15}/></span></div><span class="tool-art-index">0{index + 1}</span><span class="tool-open"><Icon name="diagonal" size={18}/></span></a>
  <div class="tool-info"><h3><a href={`${home(lang)}calculators/${tool.slug}/`}>{text.name}</a></h3><p>{text.description}</p><button class="text-link" data-open-tool={tool.slug}>{t.openTool}<Icon name="arrow" size={18}/></button></div>
</article>
