---
import type { Locale } from '../data/i18n';
const {locale='en'}=Astro.props as {locale:Locale};
const steps=locale==='en'?[
 ['A familiar calculator','Start with everyday scientific calculations. The proposed device would keep a dedicated calculation mode.','√144 + 2³','20'],
 ['Switch to AI mode','A proposed MODE shortcut would open the assistant. This is an interface simulation, not device firmware.','1  CALCULATOR\n2  AI MODE\n3  MODELS','> AI MODE'],
 ['Add your question','Tell the assistant what you want to understand. Camera input is an idea under consideration; hardware specifications are not confirmed.','PROMPT: EXPLAIN\nSolve x² − 5x + 6 = 0','[ NEXT ]'],
 ['Capture the problem','A proposed camera could send the problem to the selected assistant. OpenAI, Gemini and Claude would require separate integrations. This prepared demo does not take a photo or send a request.','MODEL: OpenAI\nPHOTO: DEMO ONLY','[ PHOTO + QUESTION ]'],
 ['Read and check the reasoning','The proposed screen would show the explanation. Verify AI reasoning against your calculation; this example is a prepared demonstration.','x² − 5x + 6 = 0\n(x − 2)(x − 3) = 0','x = 2 or x = 3']
]:[
 ['Привычный калькулятор','Начните с обычных научных вычислений. В будущем устройстве предполагается отдельный режим расчётов.','√144 + 2³','20'],
 ['Переключитесь в ИИ','Предлагаемая клавиша MODE открывала бы помощника. Здесь показана симуляция интерфейса, а не прошивка устройства.','1  CALCULATOR\n2  AI MODE\n3  MODELS','> AI MODE'],
 ['Добавьте вопрос','Укажите, в чём хотите разобраться. Ввод с камеры рассматривается как идея; характеристики оборудования пока не подтверждены.','PROMPT: EXPLAIN\nSolve x² − 5x + 6 = 0','[ NEXT ]'],
 ['Сфотографируйте задачу','Предлагаемая камера могла бы передать задачу выбранному помощнику. OpenAI, Gemini и Claude потребовали бы отдельных интеграций. Это подготовленное демо не делает фото и не отправляет запрос.','MODEL: OpenAI\nPHOTO: DEMO ONLY','[ PHOTO + QUESTION ]'],
 ['Прочитайте и проверьте решение','На экране могло бы появляться объяснение. Проверяйте рассуждения ИИ своим расчётом. Здесь показан заранее подготовленный пример.','x² − 5x + 6 = 0\n(x − 2)(x − 3) = 0','x = 2 or x = 3']
];
---
<section class="container concept-walkthrough" data-concept-demo aria-labelledby="concept-demo-title"><div class="shop-section-heading"><div><div class="eyebrow">{locale==='en'?'AN INTERFACE IDEA':'ИДЕЯ ИНТЕРФЕЙСА'}</div><h2 id="concept-demo-title">{locale==='en'?'How it could work.':'Как это могло бы работать.'}</h2></div><p>{locale==='en'?'Interactive concept · not a working device':'Интерактивный концепт · не готовое устройство'}</p></div><div class="walkthrough-grid"><div><div class="concept-lcd-frame"><div class="concept-lcd" aria-live="polite" aria-atomic="true"><div class="lcd-status"><span>CALCORA / AI ONE</span><span aria-hidden="true">▰</span></div>{steps.map((step,index)=><div data-concept-screen={index} hidden={index!==0}><pre>{step[2]}</pre><strong>{step[3]}</strong></div>)}</div></div><fieldset class="concept-models"><legend>{locale==='en'?'Possible integrations · demo only':'Возможные интеграции · только демо'}</legend>{['OpenAI','Gemini','Claude'].map((model,index)=><label><input type="radio" name="concept-model" value={model} checked={index===0}/>{model}</label>)}</fieldset><p class="concept-disclaimer">{locale==='en'?'The website’s existing AI companion uses OpenAI. Selecting a model here only changes this prepared illustration. No camera, model integration or delivery date is promised.':'Работающий помощник сайта использует OpenAI. Выбор модели здесь меняет только подготовленную иллюстрацию. Камера, интеграции и дата выпуска пока не обещаны.'}</p></div><ol class="concept-steps">{steps.map((step,index)=><li><button data-concept-step={index} aria-pressed={index===0?'true':'false'}><span>{String(index+1).padStart(2,'0')}</span>{step[0]}</button><p>{step[1]}</p></li>)}</ol></div></section>
