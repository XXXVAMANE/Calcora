---
import type { Locale } from '../data/i18n';
const {locale='en'}=Astro.props as {locale:Locale};
const steps=locale==='en'?[
 ['Calculator mode','The scientific calculator has a dedicated calculation interface.','√144 + 2³','20'],
 ['Open AI mode','Use the device’s AI mode to ask for assistance. Exact controls depend on the supplied firmware.','1  CALCULATOR\n2  AI MODE','> AI MODE'],
 ['Add a question','Describe what you want to understand. These screens illustrate an example workflow.','PROMPT: EXPLAIN\nSolve x² − 5x + 6 = 0','[ NEXT ]'],
 ['Use the rear camera','The camera is on the back of the calculator. This website illustration does not capture images or contact the device.','PHOTO: EXAMPLE\nCAMERA: REAR','[ PHOTO + QUESTION ]'],
 ['Read the display','Read the response on the built-in screen and check the reasoning. This is a prepared example, not live output.','x² − 5x + 6 = 0\n(x − 2)(x − 3) = 0','x = 2 or x = 3']
]:[
 ['Режим калькулятора','У научного калькулятора есть отдельный интерфейс вычислений.','√144 + 2³','20'],
 ['Откройте ИИ-режим','Перейдите в режим ИИ для помощи. Точные действия зависят от прошивки поставляемого устройства.','1  CALCULATOR\n2  AI MODE','> AI MODE'],
 ['Добавьте вопрос','Укажите, в чём хотите разобраться. Экраны показывают пример взаимодействия.','PROMPT: EXPLAIN\nSolve x² − 5x + 6 = 0','[ NEXT ]'],
 ['Используйте камеру сзади','Камера расположена на задней стороне калькулятора. Иллюстрация на сайте не делает снимков и не связывается с устройством.','PHOTO: EXAMPLE\nCAMERA: REAR','[ PHOTO + QUESTION ]'],
 ['Прочитайте ответ','Ответ отображается на встроенном дисплее. Проверяйте рассуждения. Здесь подготовленный пример, а не результат живого запроса.','x² − 5x + 6 = 0\n(x − 2)(x − 3) = 0','x = 2 or x = 3']
];
---
<section class="container concept-walkthrough" data-concept-demo aria-labelledby="concept-demo-title"><div class="shop-section-heading"><div><div class="eyebrow">{locale==='en'?'THE DEVICE WORKFLOW':'РАБОТА С УСТРОЙСТВОМ'}</div><h2 id="concept-demo-title">{locale==='en'?'From question to answer.':'От вопроса к ответу.'}</h2></div><p>{locale==='en'?'Illustrated workflow · sample screens':'Иллюстрация работы · примеры экранов'}</p></div><div class="walkthrough-grid"><div><div class="concept-lcd-frame"><div class="concept-lcd" aria-live="polite" aria-atomic="true"><div class="lcd-status"><span>AI / CAMERA CALCULATOR</span><span aria-hidden="true">▰</span></div>{steps.map((step,index)=><div data-concept-screen={index} hidden={index!==0}><pre>{step[2]}</pre><strong>{step[3]}</strong></div>)}</div></div><p class="concept-disclaimer">{locale==='en'?'Prepared website demonstration. Supported AI services and connectivity requirements will be confirmed with the supplier.':'Подготовленная демонстрация на сайте. Поддерживаемые ИИ-сервисы и требования к подключению уточняются у поставщика.'}</p></div><ol class="concept-steps">{steps.map((step,index)=><li><button data-concept-step={index} aria-pressed={index===0?'true':'false'}><span>{String(index+1).padStart(2,'0')}</span>{step[0]}</button><p>{step[1]}</p></li>)}</ol></div></section>
