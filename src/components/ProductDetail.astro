---
import Layout from '../layouts/Layout.astro';
import Device from './Device.astro';
import RearCamera from './RearCamera.astro';
import Icon from './Icon.astro';
import { home, type Locale } from '../data/i18n';
import { shopCopy, products, priceText, productPath, type Product } from '../data/shop';
import { guides, guidePath } from '../data/guides';
import ProductCard from './ProductCard.astro';
const { product, locale = 'en' } = Astro.props as { product: Product; locale: Locale };
const t = shopCopy[locale], text = product[locale];
const url = Astro.site ? new URL(productPath(locale,product.slug),Astro.site).href : undefined;
const schema = { '@context':'https://schema.org', '@type':'Product', name:`${product.brand} ${product.model}`, description:text.description, ...(!product.ai?{brand:{'@type':'Brand',name:product.brand},model:product.model}:{}), ...(url?{url}:{}) };
---
<Layout locale={locale} title={product.ai ? t.title : `${product.brand} ${product.model} — Numvori`} description={text.description} schema={schema} noindex={!!product.archived}>
  <div class="container physical-detail"><nav class="breadcrumbs"><a href={`${home(locale)}#catalog`}>{t.back}</a><span>/</span><span>{product.brand} {product.model}</span></nav><div class="physical-grid"><div class:list={['detail-device-stage',product.color]}><Device id="detail-device" brand={product.brand} model={product.model} concept={product.ai}/><span>{t.illustration}</span>{product.ai && <RearCamera locale={locale}/>}</div><div class="physical-copy"><div class="eyebrow"><span class="tiny-dot"></span>{text.tag}</div><span class="product-brand">{product.brand}</span><h1>{product.ai ? (locale==='en'?'AI Calculator with Camera':'ИИ-калькулятор с камерой') : product.model}</h1><p>{text.description}</p><ul class="product-features">{text.features.map(feature=><li><Icon name="check" size={17}/>{feature}</li>)}</ul>{product.price!==null ? <><div class="detail-price">{priceText(product.price,locale)}<span>{t.samplePrice}</span></div><button class="button button-dark" data-add-product={product.slug}>{t.add}<Icon name="bag" size={19}/></button><p class="detail-disclaimer">{t.checkoutNote}</p></> : <><span class="concept-price">{t.concept}</span><p class="detail-disclaimer">{locale==='en'?'Reference model only. This conventional calculator is not sold by Numvori.':'Справочная модель. Этот обычный калькулятор не продаётся в Numvori.'}</p><button class="button button-dark" data-open-tool="scientific">{t.online}<Icon name="spark" size={18}/></button></>}</div></div><section class="product-specs"><h2>{t.specs}</h2><dl>{[[t.category,text.type],[t.display,text.display],[t.power,text.power],[t.aiLabel,product.ai?t.futureAi:t.noAi]].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section><section class="product-editorial"><h2>{locale==='en'?'Is this the right calculator for you?':'Подойдёт ли вам этот калькулятор?'}</h2><p>{product.ai ? t.approachNote : (locale==='en'?'This conventional calculator is a reference for our educational buying guides. It is not part of the Numvori preorder catalog and has no built-in AI or camera.':'Обычный калькулятор приведён для справки в руководствах. Он не входит в каталог предзаказа Numvori и не имеет встроенного ИИ или камеры.')}</p>{product.ai && <><h3>{locale==='en'?'Preorder in Orlando — $280':'Предзаказ в Орландо — $280'}</h3><p>{t.collectionText}</p><p>{t.conceptNote}</p></>}<h3>{locale==='en'?'Guides to help you choose':'Руководства для выбора'}</h3><ul>{guides.filter(guide=>product.ai?guide.slug==='ai-calculator-vs-scientific-calculator':guide.models.some(slug=>slug===product.slug)).map(guide=><li><a href={guidePath(locale,guide.slug)}>{guide[locale].title}</a></li>)}</ul></section>{product.archived && <section class="related-products"><h2>{locale==='en'?'The Numvori preorder':'Предзаказ Numvori'}</h2><div class="product-grid preorder-grid">{products.map((item,index)=><ProductCard product={item} locale={locale} index={index}/>)}</div></section>}</div>
</Layout>
