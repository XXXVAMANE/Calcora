---
import Layout from '../layouts/Layout.astro';
import ProductCard from './ProductCard.astro';
import { products, productPath } from '../data/shop';
import { guidePath } from '../data/guides';
import { home, type Locale } from '../data/i18n';
const { locale='en' }=Astro.props as {locale:Locale};
const title=locale==='en'?'Scientific calculators: compare Casio & TI':'Научные калькуляторы: сравнение Casio и TI';
const description=locale==='en'?'Explore Casio fx-300ES PLUS, ClassWiz fx-991CW and TI-30X IIS scientific calculators. Compare displays, features and power before choosing.':'Сравните научные калькуляторы Casio fx-300ES PLUS, ClassWiz fx-991CW и TI-30X IIS: экран, возможности и питание.';
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:title,description,inLanguage:locale,mainEntity:{'@type':'ItemList',itemListElement:products.filter(p=>!p.ai).map((product,index)=>({'@type':'ListItem',position:index+1,name:`${product.brand} ${product.model}`,url:new URL(productPath(locale,product.slug),Astro.site).href}))}};
---
<Layout locale={locale} title={`${title} | Numvori`} description={description} schema={schema}><div class="container editorial"><nav class="breadcrumbs"><a href={home(locale)}>Numvori</a><span>/</span><span>{locale==='en'?'Scientific calculators':'Научные калькуляторы'}</span></nav><header class="editorial-heading"><div class="eyebrow">THE COLLECTION / 03</div><h1>{title}</h1><p>{description}</p></header><p class="editorial-note scientific-intro">{locale==='en'?'These are conventional physical scientific calculators without built-in AI or cameras. This store is a demo: sample prices, test checkout, no real shipment. Check your course requirements and the exact model manual before choosing.':'Это обычные физические научные калькуляторы без встроенного ИИ и камеры. Магазин демонстрационный: примерные цены, тестовая оплата, без настоящей доставки. Проверьте требования курса и инструкцию точной модели.'}</p><div class="product-grid">{products.filter(p=>!p.ai).map((product,index)=><ProductCard product={product} locale={locale} index={index}/>)}</div><section class="product-editorial"><h2>{locale==='en'?'How to narrow your choice':'Как сузить выбор'}</h2><p>{locale==='en'?'Start with the operations you need and a display you can read comfortably. Textbook-style and two-line displays offer different ways to check your input. For more advanced work, compare equation and matrix tools. Exam permission depends on the exact model and the current rules of your exam provider.':'Начните с нужных операций и удобного экрана. Математическая запись и двухстрочный дисплей по-разному помогают проверять ввод. Для сложных задач сравните инструменты для уравнений и матриц. Допуск к экзамену зависит от точной модели и правил организатора.'}</p><a href={guidePath(locale,'choose-a-scientific-calculator')}>{locale==='en'?'Read the scientific calculator buying guide':'Читать руководство по выбору'} ↗</a></section></div></Layout>
