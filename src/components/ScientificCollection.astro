---
import Layout from '../layouts/Layout.astro';
import ProductCard from './ProductCard.astro';
import { products, productPath } from '../data/shop';
import { guidePath } from '../data/guides';
import { home, type Locale } from '../data/i18n';
const { locale='en' }=Astro.props as {locale:Locale};
const title=locale==='en'?'AI calculator with camera: preorder in Orlando':'ИИ-калькулятор с камерой: предзаказ в Орландо';
const description=locale==='en'?'One AI camera calculator, $280 preorder price. Built-in display and rear camera. Planned Orlando delivery and pickup; timing to be confirmed.':'Один ИИ-калькулятор с камерой, предзаказ за $280. Встроенный дисплей и камера сзади. Доставка и самовывоз в Орландо планируются; сроки уточняются.';
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:title,description,inLanguage:locale,mainEntity:{'@type':'ItemList',itemListElement:products.map((product,index)=>({'@type':'ListItem',position:index+1,name:`${product.brand} ${product.model}`,url:new URL(productPath(locale,product.slug),Astro.site).href}))}};
---
<Layout locale={locale} title={`${title} | Numvori`} description={description} schema={schema}><div class="container editorial"><nav class="breadcrumbs"><a href={home(locale)}>Numvori</a><span>/</span><span>{locale==='en'?'Scientific calculators':'Научные калькуляторы'}</span></nav><header class="editorial-heading"><div class="eyebrow">PREORDER / 01</div><h1>{title}</h1><p>{description}</p></header><p class="editorial-note scientific-intro">{locale==='en'?'Numvori resells this device. Preorder checkout is test-only: it does not charge money or reserve stock. Arrival date, delivery fees and pickup location are not confirmed.':'Numvori перепродаёт устройство. Оплата предзаказа только тестовая: без списания денег и резервирования товара. Дата поступления, тарифы доставки и место самовывоза уточняются.'}</p><div class="product-grid preorder-grid">{products.map((product,index)=><ProductCard product={product} locale={locale} index={index}/>)}</div><section class="product-editorial"><h2>{locale==='en'?'Delivery and pickup in Orlando':'Доставка и самовывоз в Орландо'}</h2><p>{locale==='en'?'The device is offered for preorder at $280. Numvori plans local delivery and pickup in Orlando; the arrival date, delivery fees and pickup location will be confirmed before real orders open. The current test checkout does not charge money or reserve a device.':'Устройство предлагается по предзаказу за $280. Numvori планирует доставку и самовывоз в Орландо; дата поступления, тарифы доставки и место самовывоза будут уточнены до открытия реальных заказов. Тестовая оплата сейчас не списывает деньги и не резервирует устройство.'}</p><a href={guidePath(locale,'ai-calculator-vs-scientific-calculator')}>{locale==='en'?'AI and conventional calculators: understand the difference':'ИИ и обычные калькуляторы: в чём разница'} ↗</a></section></div></Layout>
