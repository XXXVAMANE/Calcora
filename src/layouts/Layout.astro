---
import Icon from '../components/Icon.astro';
import CalculatorPanel from '../components/CalculatorPanel.astro';
import { copy, home, type Locale } from '../data/i18n';
import { canIndex } from '../utils/seo';
import '../styles/global.css';
const { locale = 'en', title, description, schema, noindex = false } = Astro.props;
const lang = locale as Locale;
const t = copy[lang];
const pageTitle = title || t.title;
const pageDescription = description || t.description;
const root = home(lang);
const production = Astro.site && Astro.site.hostname !== 'example.com';
const pathname = Astro.url.pathname;
const englishPath = pathname.replace(/^\/ru(?=\/|$)/, '') || '/';
const russianPath = '/ru' + englishPath;
const canonical = production ? new URL(pathname, Astro.site).href : undefined;
const jsonLd = schema || { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Calcora', inLanguage: ['en', 'ru'], ...(production ? { url: Astro.site?.href } : {}) };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f2" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={!canIndex(Astro.site) || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="en" href={production ? new URL(englishPath, Astro.site).href : englishPath} />
    <link rel="alternate" hreflang="ru" href={production ? new URL(russianPath, Astro.site).href : russianPath} />
    <link rel="alternate" hreflang="x-default" href={production ? new URL(englishPath, Astro.site).href : englishPath} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'ru_RU' : 'en_US'} />
    <meta property="og:site_name" content="Calcora" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={production ? new URL('/og-cover.png', Astro.site).href : '/og-cover.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="announcement"><span>{t.announcement}</span><a href={`${root}#how`}>{t.announcementLink}<Icon name="diagonal" size={11}/></a></div>
    <header class="header"><div class="container header-inner">
      <a class="brand" href={root} aria-label="Calcora"><span class="brand-icon" aria-hidden="true"><span></span><span></span><span></span><span></span></span>calcora<span class="brand-dot">✳</span></a>
      <nav class="desktop-nav" aria-label={lang === 'en' ? 'Main navigation' : 'Основная навигация'}><a href={`${root}#catalog`}>{t.calculators}</a><a href={`${root}#how`}>{t.how}</a><a href={`${root}#pricing`}>{t.pricing}</a></nav>
      <div class="header-actions"><div class="language-switch" aria-label={lang === 'en' ? 'Language' : 'Язык'}><a href={englishPath} lang="en" hreflang="en" class:list={{ active: lang === 'en' }} aria-current={lang === 'en' ? 'page' : undefined}>EN</a><span>/</span><a href={russianPath} lang="ru" hreflang="ru" class:list={{ active: lang === 'ru' }} aria-current={lang === 'ru' ? 'page' : undefined}>RU</a></div><button class="button button-small button-dark header-try" data-open-tool="scientific">{t.tryFree}<Icon name="diagonal" size={16}/></button><button class="icon-button mobile-menu-button" data-menu-toggle aria-label={t.menu} aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu"/></button></div>
    </div><nav class="mobile-nav" id="mobile-nav" aria-label={t.menu} hidden><a href={`${root}#catalog`}>{t.calculators}</a><a href={`${root}#how`}>{t.how}</a><a href={`${root}#pricing`}>{t.pricing}</a><button data-open-tool="scientific">{t.tryFree} ↗</button></nav></header>
    <main id="main"><slot /></main>
    <footer class="footer"><div class="container"><div class="footer-main"><div><a class="brand" href={root}>calcora<span class="brand-dot">✳</span></a><p class="preserve-lines">{t.footerText}</p></div><div class="footer-links"><div><span class="micro-label">{t.explore}</span><a href={`${root}#catalog`}>{t.calculators}</a><a href={`${root}#how`}>{t.how}</a><a href={`${root}#pricing`}>{t.pricing}</a></div><div><span class="micro-label">{t.information}</span><a href={`${root}#philosophy`}>{lang === 'en' ? 'Our approach' : 'Наш подход'}</a><a href={`${root}#faq`}>{lang === 'en' ? 'Questions & answers' : 'Вопросы и ответы'}</a><a href={`${root}privacy/`}>{t.privacy}</a></div></div><div class="footer-note"><span class="footer-symbol" aria-hidden="true">✳</span><p class="preserve-lines">{t.footerMark}</p></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Calcora</span><span>{t.footerDemo}</span><a href="#main">{t.top} ↑</a></div></div></footer>
    <dialog class="calculator-dialog" id="calculator-dialog" aria-labelledby="calculator-title"><div class="dialog-heading"><div><span class="eyebrow"><span class="tiny-dot"></span>{t.demo}</span><h2 id="calculator-title">{t.calculatorTitle}</h2></div><button class="icon-button" data-close-dialog aria-label={t.close}><Icon name="close"/></button></div><CalculatorPanel locale={lang}/></dialog>
    <dialog class="plan-dialog" id="plan-dialog" aria-labelledby="plan-title"><div class="dialog-heading"><h2 id="plan-title">{t.planTitle}</h2><button class="icon-button" data-close-dialog aria-label={t.planClose}><Icon name="close"/></button></div><span class="plan-badge" id="selected-plan"></span><p>{t.planMessage}</p><button class="button button-dark full-width" data-open-tool="scientific">{t.planAction}<Icon name="arrow"/></button></dialog>
    <script id="ui-copy" type="application/json" set:html={JSON.stringify(t).replace(/</g, '\\u003c')}/>
    <script>import '../scripts/store';</script>
  </body>
</html>
