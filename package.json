{
  "name": "calcora-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "start": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "astro": "5.16.6",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
