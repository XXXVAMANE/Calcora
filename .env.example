# Export this in the shell before running npm run build.
PUBLIC_SITE_URL=https://example.com
# Browser-safe Supabase project URL and publishable key. Never use a service-role/secret key here.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only AI integration. Never use a PUBLIC_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4321
